OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_TIMEOUT=300
APP_HOST=127.0.0.1
APP_PORT=8000
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_ENDPOINT=https://api.tavily.com/search
SEARCH_TIMEOUT=20
SEARCH_RESULT_COUNT=5
EXTRACTION_TIMEOUT=20
EXTRACTION_MAX_CHARS=12000
# JSON array of MCP servers. The local utility server is enabled by default:
MCP_SERVERS_JSON=[{"name":"local_utility_server","transport":"stdio","command":"python","args":["-m","app.mcp_servers.utility_server"]}]
MCP_TIMEOUT=30
MAX_TOOL_ROUNDS=3
MCP_AUTO_CONNECT=true
EMBEDDING_MODEL=nomic-embed-text
CHROMA_PERSIST_DIRECTORY=./data/chroma
DOCUMENT_STORAGE_DIRECTORY=./data/documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.0
AGENT_MAX_STEPS=8
AGENT_TIMEOUT=300
